# ==========================================
# RushDesk Voice Worker — Configuration
# ==========================================

# Google Gemini API Key (from Google AI Studio or Vertex AI)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Deepgram (Speech to Text)
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Cartesia (Text to Speech)
CARTESIA_API_KEY="your-cartesia-api-key"
CARTESIA_VOICE_ID="your-french-voice-id"

# Twilio (Telephony)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"

# RushDesk Next.js Backend URL (KDS / Order ingestion)
RUSHDESK_API_URL="http://localhost:3000/api/voice/submit-order"
RUSHDESK_SHARED_SECRET=""

# Server settings
PORT=8765
HOST="0.0.0.0"
LOG_LEVEL="INFO"
